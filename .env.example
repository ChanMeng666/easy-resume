# ===========================================
# Vitex - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# -------------------------------------------
# Neon Auth (Stack Auth)
# Stack Auth IS Neon Auth — Neon acquired Stack Auth, and the @stackframe/stack
# SDK is the (legacy) Neon Auth integration, fully supported. Enable Neon Auth
# in the Neon Console (Auth tab) or get keys from https://app.stack-auth.com/
# -------------------------------------------
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# -------------------------------------------
# Database (Neon PostgreSQL)
# Get connection string from https://neon.tech/
# -------------------------------------------
DATABASE_URL=

# -------------------------------------------
# OpenAI API (powers the AI generation pipeline)
# Get API key from https://platform.openai.com/
# -------------------------------------------
OPENAI_API_KEY=

# Model tiering (optional overrides). Three tiers:
#   extract — cheap read/structure steps (JD parse).
#   reason  — quality-critical generation steps (background parse, match,
#             tailor, cover letter, both revisers).
#   chat    — the conversational edit agent's tool loop. It is free for the user
#             and rate-limited at 30 turns/min, so it is the most cost-sensitive
#             surface in the repo and gets its own tier.
# The ids below are DATED SNAPSHOTS on purpose — pinned weights, no silent
# updates. The gpt-5.6 family (`-sol`/`-terra`/`-luna`) was evaluated with a real
# A/B and DECLINED: every 5.6 arm compressed the resume by about a third
# (highlight bullets 17.3 -> 11-12) and dropped true facts the candidate actually
# had, and `sol` — same price as gpt-5.5 — scored worse on both fixtures. See
# docs/decisions/0004-model-tiering-gpt-5-6.md before proposing a swap.
# CHAT defaults to the same model as REASON; the tier exists so the edit-agent
# loop can carry its own effort (and, later, its own model) without a code change.
AI_MODEL_EXTRACT=gpt-5.4-mini-2026-03-17
AI_MODEL_REASON=gpt-5.5-2026-04-23
AI_MODEL_CHAT=gpt-5.5-2026-04-23

# Reasoning effort per tier (only sent to reasoning models — the gpt-5 family
# except gpt-5-chat-*, and the o-series; ignored for gpt-4.x / *-chat). Lower =
# faster + cheaper. Accepted: none | low | medium | high | xhigh.
#
# THE LEGAL SET IS PER-MODEL AND THE API IS STRICT. An unsupported value is a
# hard 400 from the Responses API, not a warning and not a silent downgrade —
# and the AI SDK neither normalizes nor validates the value, it forwards it
# verbatim. Two traps this has already cost us:
#   * `minimal` is NOT accepted by ANY model we run — it is not in gpt-5.4-mini's
#     or gpt-5.5's advertised set (none/low/medium/high/xhigh), nor in gpt-5.6's.
#     It shipped as the extract-tier default and 400'd every generation for three
#     weeks. Deliberately absent from the list above.
#   * `max` exists ONLY on gpt-5.6, which we do not run. Sending it to
#     gpt-5.4-mini / gpt-5.5 is a 400, so it is not in the list either.
# Verify against the target model before setting a value here.
#
# EXTRACT uses `none` deliberately: JD parsing is extraction, not reasoning, and
# `none` is additionally the only effort under which the provider actually sends
# a temperature — so it is what makes AI_TEMPERATURE_EXTRACT=0 live, restoring the
# determinism the JD parse cache assumes.
#
# Raise AI_REASONING_EFFORT_REASON to medium/high for more quality at the cost
# of latency; `none` is the floor for the fastest, cheapest calls.
AI_REASONING_EFFORT_EXTRACT=none
AI_REASONING_EFFORT_REASON=low
AI_REASONING_EFFORT_CHAT=low

# Sampling temperature per task type. extract = read/structure/judge steps (kept
# at 0 for reproducibility); writing = prose generation.
# NOTE on reasoning models: they do NOT 400 on a temperature. @ai-sdk/openai only
# forwards `temperature` when the effort is `none` AND the model is gpt-5.1 or
# newer; in every other case it silently strips the value and emits a warning.
# Useful side effect of the extract tier running at `none`: AI_TEMPERATURE_EXTRACT
# is actually sent there, so JD parsing regains its deterministic temperature 0.
# AI_TEMPERATURE_WRITING stays inert while the reason/chat tiers run at `low`.
AI_TEMPERATURE_EXTRACT=0
AI_TEMPERATURE_WRITING=0.5

# -------------------------------------------
# AI observability (optional)
# When true, the AI SDK emits OpenTelemetry spans (e.g. for Langfuse).
# -------------------------------------------
AI_TELEMETRY_ENABLED=false
# Record raw prompt inputs/outputs (resume + JD = PII) on spans. OFF by default;
# only enable if your OTel collector is private and compliant. With it off, spans
# still carry timing/token/cost — just not the candidate's text.
AI_TELEMETRY_RECORD_IO=false

# Structured log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Max concurrently EXECUTING v1 background jobs (generation + refine). Excess
# accepted jobs wait FIFO with status `queued`. Default: 2 (each run is an LLM
# call chain + a typst subprocess on a single VPS).
# JOB_CONCURRENCY=2

# -------------------------------------------
# Stripe (billing)
# Secret + webhook signing secret from https://dashboard.stripe.com/apikeys and
# the webhook endpoint settings. The three price IDs identify the credit pack and
# subscription products (server-side env, read by src/lib/stripe/checkout.ts).
# -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_5=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_UNLIMITED_MONTHLY=

# -------------------------------------------
# Typst (PDF compilation) — usually only set in Docker
# TYPST_BIN is the typst binary path; TYPST_FONT_PATH points at the bundled
# FontAwesome webfonts. In dev these auto-detect from node_modules.
# -------------------------------------------
# TYPST_BIN=typst
# TYPST_FONT_PATH=/app/fonts

# -------------------------------------------
# Application URL
# -------------------------------------------
# Local development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production (update this to your deployed URL)
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# -------------------------------------------
# Object storage for compiled PDFs (Cloudflare R2 — OPTIONAL)
# When all four are set, compiled resume/cover-letter PDFs are persisted to R2
# and served from there; otherwise the PDF routes recompile from the stored
# Typst source on demand (<100ms). Create an R2 bucket + API token (Object Read
# & Write) at https://dash.cloudflare.com/ → R2.
# -------------------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# -------------------------------------------
# Visual asset generation (scripts/generate-visual-assets.mjs)
# Optional — only needed to regenerate the illustration layer with GPT-Image-2.
# Falls back to OPENAI_API_KEY if this is unset.
# -------------------------------------------
OPENAI_IMAGE_API_KEY=
